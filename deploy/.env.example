# Copy to deploy/.env and fill in. Never commit deploy/.env (real credentials).

# ── Server ──────────────────────────────────────────────────────────────────
# Same box as taxhelperbd.com. DEPLOY_SSH_USER is the non-root user created by
# provision.sh; it already exists on this server.
DEPLOY_SSH_HOST=165.99.219.35
DEPLOY_SSH_USER=deploy
DEPLOY_SSH_PORT=22

# Only used by deploy/scripts/provision.sh, on a FRESH box, before the deploy
# user exists. Leave empty for the already-provisioned server.
DEPLOY_PROVISION_USER=root
DEPLOY_ROOT_PASSWORD=

# ── Domain / TLS ────────────────────────────────────────────────────────────
# Needs an A record → DEPLOY_SSH_HOST before Caddy can issue a certificate.
DEPLOY_DOMAIN=debtbooktracker.com
DEPLOY_PUBLIC_URL=https://debtbooktracker.com
DEPLOY_ACME_EMAIL=shahanulhaqueshawon@gmail.com

# ── Image ───────────────────────────────────────────────────────────────────
# DEPLOY_TAG is bumped automatically by scripts/docker-publish.sh.
DEPLOY_IMAGE_REPO=shawon1fb/debtbook-legal-site
DEPLOY_TAG=latest

# ── Docker ──────────────────────────────────────────────────────────────────
# MUST match the network the existing Caddy container is attached to, otherwise
# Caddy cannot resolve the site container by name.
DEPLOY_NETWORK=bd-tax-network
# The Caddy container already running on this server. remote-proxy.sh merges the
# debtbook site block into ITS Caddyfile instead of starting a second proxy.
CADDY_CONTAINER=bd-tax-caddy
